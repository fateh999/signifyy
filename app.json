{
  "expo": {
    "name": "Signifyy",
    "slug": "signifyy",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00A1E4",
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/splash.png",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 128
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.signifyy.fateh999",
      "buildNumber": "4004",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to add a signature image",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to capture a signature"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00A1E4"
      },
      "package": "com.signifyy.fateh999",
      "versionCode": 4004,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fb2bd920-3407-45cc-b5aa-03280502a3ef"
      }
    },
    "owner": "fateh999"
  }
}
